<% layout("../layouts/application", { header: it.article.title }) %>
<%~ include("../mixins/article", { content: it.article.content }) %>

<section id="comments" class="mt-10 border-t border-gray-200 pt-6">
  <h2 class="mb-4 text-2xl font-bold">
    <%= it.t('views.comments.header') %> (<%= it.comments.length %>)
  </h2>

  <% if (it.comments.length === 0) { %>
  <p class="mb-6 text-gray-600"><%= it.t('views.comments.empty') %></p>
  <% } else { %>
  <ul class="mb-8 space-y-4">
    <% it.comments.forEach((comment) => { %>
    <li class="rounded border border-gray-200 p-4">
      <div class="mb-2 flex items-center justify-between">
        <span class="font-semibold"><%= comment.author %></span>
        <span class="text-sm text-gray-500"><%= it.formatDate(comment.createdAt) %></span>
      </div>
      <%~ include("../mixins/article", { content: comment.content }) %>
      <%~ include("../mixins/buttonTo", {
        action: it.route('comment', { articleId: it.article.id, id: comment.id }),
        method: 'delete',
        value: it.t('views.comments.delete'),
        class: 'mt-2 cursor-pointer text-sm text-red-600',
        onclick: `return confirm('${it.t('views.comments.delete_confirmation')}')`,
      }) %>
    </li>
    <% }) %>
  </ul>
  <% } %>

  <h3 class="mb-4 text-xl font-bold"><%= it.t('views.comments.form.header') %></h3>
  <form action="<%= it.route('articleComments', { id: it.article.id }) %>" method="post">
    <%~ include("../mixins/input", {
      entity: it.comment,
      propertyName: 'author',
      errors: it.errors,
      scope: 'comment',
      fieldPrefix: 'comment',
      type: 'text',
    }) %>
    <%~ include("../mixins/textarea", {
      entity: it.comment,
      propertyName: 'content',
      errors: it.errors,
      scope: 'comment',
      fieldPrefix: 'comment',
      placeholder: it.t('views.comment.content.placeholder'),
      rows: 4,
    }) %>
    <%~ include("../mixins/submit", { value: it.t('views.comments.form.submit') }) %>
  </form>
</section>
